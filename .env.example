# ==============================================================================
# 100% HUMANITY — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` for local development. NEVER commit `.env` to Git!
# ==============================================================================

# 1. Core Django Settings
# Generate a strong secret key via:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-secure-50-character-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.vercel.app,.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 2. Database Configuration
# Leave DATABASE_URL blank locally to use SQLite (db.sqlite3) automatically.
# In production (Render / Vercel), set to your free Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 3. Cloudinary Image Storage (Free Tier: 25 monthly credits, no credit card needed)
# Get these from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=100_humanity

# 4. Site Identity Defaults (Editable anytime via Django Admin -> Site Settings)
SITE_NAME=100% HUMANITY
CONTACT_PERSON=Arvind Betkar
CONTACT_EMAIL=arvindbet12@gmail.com
CONTACT_PHONE=8983087210
YOUTUBE_CHANNEL_NAME=100% HUMANITY
YOUTUBE_CHANNEL_URL=

# 5. Google Analytics (GA4 Measurement ID starting with G-)
GOOGLE_ANALYTICS_ID=G-QRLSPJ2R6J
